[Unit]
Description=Sai Virtualization Daemon
# ordering only: sai-virt copes with libvirt or its network coming later
After=network-online.target libvirtd.service virtqemud.service virtnetworkd.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/sai-virt

[Install]
WantedBy=multi-user.target
