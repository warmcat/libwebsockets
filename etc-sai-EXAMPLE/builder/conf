{
        "perms":        "sai:nobody",
        "home":         "/home/sai",
        "host":         "bionic-noi",

	# the fleet-wide secret sai-server's "link-key" pvo also has;
	# the server refuses our connection without it, and it is
	# presented to sai-power at registration
	#
	"link-key":	"34c8e17b90d2a6f5c1e8430b76af2915e0d4cbf68a27e19dd5b0f3c6e48a71d2",

	"rebuild_script_user": "cd ~/libwebsockets/build && git fetch origin +main:m && git reset --hard m && make -j12 && cd ../../sai/build && git fetch origin +main:m && git reset --hard m && make -j12",
	"rebuild_script_root": "cd /home/agreen/libwebsockets/build && make -j12 install && cd /home/agreen/sai/build && make -j12 install && systemctl restart sai-builder",

	# if you are using auto-power-on and off, the builder needs
	# to point to a sai-power instance that can coordinate power-off
	# when the builder decides it is idle
	# "sai-power":    "http://10.199.0.10:3333",

        "platforms": [
                {
                        "name":         "linux-ubuntu-1804/x86_64-amd/gcc",
                        "instances":    3,

			# optional: spend up to half this platform's idle time on
			# idle tasks (eg, fuzzing), two at a time, in 15 minute
			# slices.  See READMEs/README-idle.md
			"idle": {
				"share":	50,
				"instances":	2,
				"slice-secs":	900,
				"settle-secs":	120
			},

                        "servers": [ "wss://libwebsockets.org:4444/sai/builder" ]
                },
		{
			"name":		"freertos-linkit/arm32-m4-mt7697-usi/gcc",
			"instances":	1,

			# optional: set up the environment the platform's builds
			# see, see READMEs/README-builder-env.md
			"env":	[
				"PATH=/opt/linkit/bin:$PATH",
				{ "SAI_CROSS_BASE": "/opt/linkit" }
			],
			"servers": [ "wss://libwebsockets.org:4444/sai/builder" ]
		}
        ]
}
