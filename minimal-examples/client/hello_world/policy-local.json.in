{
  "release": "1",
  "product": "minimal-secure-streams",
  "schema-version": 1,
  "retry": [
    {
      "default": {
        "backoff": [ 1000, 2000, 3000, 5000, 10000 ],
        "conceal": 5,
        "jitterpc": 20,
        "svalidping": 30,
        "svalidhup": 35
      }
    }
  ],
  "certs": [
    {
      "localhost_100y": ""
    }
  ],
  "trust_stores": [
    {
      "name": "local_test",
      "stack": [ "localhost_100y" ]
    }
  ],
  "s": [
    {
      "__default": {
        "endpoint": "${endpoint}",
        "port": 443,
        "protocol": "h1",
        "http_method": "GET",
        "http_url": "",
        "metadata": [ { "endpoint": "" } ],
        "direct_proto_str": true,
        "tls": true,
        "allow_redirects": true,
        "opportunistic": true,
        "retry": "default",
        "tls_trust_store": "local_test"
      }
    }
  ]
}
