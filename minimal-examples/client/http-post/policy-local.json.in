{
  "release": "1",
  "product": "sx-http-post",
  "schema-version": 1,
  "retry": [
    {
      "default": {
        "backoff": [ 1000, 2000, 3000, 5000, 10000 ],
        "conceal": 5,
        "jitterpc": 20,
        "svalidping": 30,
        "svalidhup": 35
      }
    }
  ],
  "certs": [
    {
      "localhost_100y": ""
    }
  ],
  "trust_stores": [
    {
      "name": "local_test",
      "stack": [ "localhost_100y" ]
    }
  ],
  "s": [
    {
      "minpost": {
        "endpoint": "@LWS_CTEST_SERVER_RESOLVE@",
        "port": @PORT_HP_SRV_TLS@,
        "protocol": "h1",
        "http_method": "POST",
        "http_url": "/httpbin/bytes/2000",
        "metadata": [ { "ctype": "Content-Type:" } ],
        "tls": true,
        "opportunistic": true,
        "allow_redirects": true,
        "retry": "default",
        "tls_trust_store": "local_test"
      }
    }
  ]
}
