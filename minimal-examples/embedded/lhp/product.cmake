#
# Makes product.h: what the settings show of the product itself, at the top of
# them, both on the display and served to a browser while the device is an AP
# to be set up: the maker's name and logo, the model's name and a picture of
# it, as C arrays.
#
# The files are in product/ beside this:
#
#   header.html   the html, @LHP_MODEL@ in it is the board's model name
#   header.css    its css, which can't contain '<'
#   logo.svg      the maker's logo, served as product-logo.svg
#   device.svg    a picture of the device, served as product-device.svg
#
# A board can have its own of any of them, in product/ in its own dir: those
# are used instead.  The model name is the board's own, given by its
# main/CMakeLists.txt.  It is used in the html as it is, so it is html.
#
#   include(<this dir>/product.cmake)
#   lhp_product(${CMAKE_CURRENT_BINARY_DIR}/product.h "<model>" <board dir>)
#

include(${CMAKE_CURRENT_LIST_DIR}/boot-icons.cmake)

set(LHP_PRODUCT_DIR ${CMAKE_CURRENT_LIST_DIR}/product)

# the board's own file called name, if it has one, else the common one

function(lhp_product_file name BOARD result)
	if (EXISTS ${BOARD}/product/${name})
		set(${result} ${BOARD}/product/${name} PARENT_SCOPE)
	else()
		set(${result} ${LHP_PRODUCT_DIR}/${name} PARENT_SCOPE)
	endif()
endfunction()

function(lhp_product OUT MODEL BOARD)
	set(h "/* generated by product.cmake from product/ */\n\n")

	lhp_product_file(header.html ${BOARD} f)
	if (NOT CMAKE_SCRIPT_MODE_FILE)
		set_property(DIRECTORY APPEND PROPERTY
			     CMAKE_CONFIGURE_DEPENDS ${f})
	endif()
	file(READ ${f} html)
	string(REPLACE "@LHP_MODEL@" "${MODEL}" html "${html}")
	string(HEX "${html}" hex)
	lhp_hex_append(product_header_html "${hex}" TRUE)

	lhp_product_file(header.css ${BOARD} f)
	lhp_embed_append(${f} product_header_css TRUE)
	lhp_product_file(logo.svg ${BOARD} f)
	lhp_embed_append(${f} product_logo FALSE)
	lhp_product_file(device.svg ${BOARD} f)
	lhp_embed_append(${f} product_device FALSE)

	lhp_write_if_changed(${OUT} "${h}")
endfunction()
